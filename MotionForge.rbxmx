-- ========== WIDGET HELPERS ==========
-- Everything stacks with UIListLayout, so nothing depends on hand-placed Y positions.
local childOrders = setmetatable({}, { __mode = "k" })
local function nextOrder(parent)
	local n = (childOrders[parent] or 0) + 1
	childOrders[parent] = n
	return n
end

local function addCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 6)
	corner.Parent = parent
	return corner
end

local function addStack(parent, padding)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, padding or 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

local function createCard(title, layoutOrder)
	local card = Instance.new("Frame")
	card.BackgroundColor3 = C.card
	card.BorderSizePixel = 0
	card.LayoutOrder = layoutOrder
	card.Size = UDim2.new(1, -24, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.Parent = scrollContent
	addCorner(card, 10)

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.Parent = card

	addStack(card, 8)

	local header = Instance.new("TextLabel")
	header.Text = title
	header.TextColor3 = Color3.fromRGB(220, 220, 230)
	header.TextSize = 14
	header.Font = Enum.Font.GothamSemibold
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 24)
	header.LayoutOrder = 0
	header.Parent = card
	return card
end

local function addNote(parent, text)
	local label = Instance.new("TextLabel")
	label.Text = text
	label.TextColor3 = C.dim
	label.TextSize = 11
	label.Font = Enum.Font.Gotham
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.LayoutOrder = nextOrder(parent)
	label.Parent = parent
	return label
end

local function addLabel(parent, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.Text = text
	label.TextColor3 = color or C.text
	label.TextSize = size or 12
	label.Font = font or Enum.Font.Gotham
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.LayoutOrder = nextOrder(parent)
	label.Parent = parent
	return label
end

local function styleButton(btn, text, color, textSize)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = textSize or 12
	btn.Font = Enum.Font.GothamSemibold
	btn.BackgroundColor3 = color
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = true
	addCorner(btn, 8)
end

local function addButton(parent, text, color, height, callback)
	local btn = Instance.new("TextButton")
	styleButton(btn, text, color, 12)
	btn.Size = UDim2.new(1, 0, 0, height or 34)
	btn.LayoutOrder = nextOrder(parent)
	btn.Parent = parent
	if callback then
		btn.MouseButton1Click:Connect(callback)
	end
	return btn
end

-- specs = { {text, color, callback}, ... } laid out side by side
local function addButtonRow(parent, specs, height)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, height or 34)
	row.LayoutOrder = nextOrder(parent)
	row.Parent = parent

	local gap = 6
	local count = #specs
	local rowLayout = Instance.new("UIListLayout")
	rowLayout.FillDirection = Enum.FillDirection.Horizontal
	rowLayout.Padding = UDim.new(0, gap)
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowLayout.Parent = row

	local buttons = {}
	for i, spec in ipairs(specs) do
		local btn = Instance.new("TextButton")
		styleButton(btn, spec[1], spec[2], 11)
		btn.Size = UDim2.new(1 / count, -gap * (count - 1) / count, 1, 0)
		btn.LayoutOrder = i
		btn.Parent = row
		if spec[3] then
			btn.MouseButton1Click:Connect(spec[3])
		end
		table.insert(buttons, btn)
	end
	return buttons, row
end

local function addRow(parent, labelText, defaultValue, onChanged)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 32)
	row.LayoutOrder = nextOrder(parent)
	row.Parent = parent

	local label = Instance.new("TextLabel")
	label.Text = labelText
	label.TextColor3 = C.sub
	label.TextSize = 12
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(0, 118, 1, 0)
	label.Parent = row

	local input = Instance.new("TextBox")
	input.Text = tostring(defaultValue or "")
	input.TextColor3 = Color3.fromRGB(255, 255, 255)
	input.PlaceholderColor3 = C.dim
	input.TextSize = 12
	input.Font = Enum.Font.Gotham
	input.TextXAlignment = Enum.TextXAlignment.Left
	input.ClearTextOnFocus = false
	input.BackgroundColor3 = C.field
	input.BorderSizePixel = 0
	input.Size = UDim2.new(1, -124, 1, 0)
	input.Position = UDim2.new(0, 124, 0, 0)
	input.Parent = row
	addCorner(input, 6)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = input

	if onChanged then
		input:GetPropertyChangedSignal("Text"):Connect(function()
			onChanged(input.Text)
		end)
	end
	return row, input
end

-- ON/OFF row. Returns a function that re-reads the value (used after loading a move/template).
local function addToggleRow(parent, labelText, getter, setter)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 32)
	row.LayoutOrder = nextOrder(parent)
	row.Parent = parent

	local label = Instance.new("TextLabel")
	label.Text = labelText
	label.TextColor3 = C.sub
	label.TextSize = 12
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -100, 1, 0)
	label.Parent = row

	local toggle = Instance.new("TextButton")
	toggle.Size = UDim2.new(0, 92, 1, 0)
	toggle.Position = UDim2.new(1, -92, 0, 0)
	toggle.Parent = row
	styleButton(toggle, "", C.dark, 12)

	local function refresh()
		local on = getter()
		toggle.Text = on and "✅ ON" or "⬜ OFF"
		toggle.BackgroundColor3 = on and C.blue or C.dark
	end
	toggle.MouseButton1Click:Connect(function()
		setter(not getter())
		refresh()
	end)
	refresh()
	return refresh
end

-- Number box that clamps into [lo, hi]. Returns a refresh function.
local function addNumberRow(parent, labelText, getter, setter, lo, hi)
	local _, input = addRow(parent, labelText, fmt(getter()), function(text)
		local n = tonumber(text)
		if n then
			setter(clamp(n, lo, hi))
		end
	end)
	input.FocusLost:Connect(function()
		input.Text = fmt(getter())
	end)
	return function()
		input.Text = fmt(getter())
	end
end

-- Modal dialog. Returns (panel, close). Add children to `panel` with the helpers above.
local function openDialog(titleText, maxWidth)
	local overlay = Instance.new("ScrollingFrame")
	overlay.Size = UDim2.new(1, 0, 1, 0)
	overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlay.BackgroundTransparency = 0.45
	overlay.BorderSizePixel = 0
	overlay.ScrollBarThickness = 6
	overlay.CanvasSize = UDim2.new(0, 0, 0, 0)
	overlay.AutomaticCanvasSize = Enum.AutomaticSize.Y
	overlay.ZIndex = 50
	overlay.Active = true
	overlay.Parent = mainGui

	local overlayLayout = Instance.new("UIListLayout")
	overlayLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	overlayLayout.SortOrder = Enum.SortOrder.LayoutOrder
	overlayLayout.Parent = overlay
	local overlayPad = Instance.new("UIPadding")
	overlayPad.PaddingTop = UDim.new(0, 20)
	overlayPad.PaddingBottom = UDim.new(0, 20)
	overlayPad.PaddingLeft = UDim.new(0, 10)
	overlayPad.PaddingRight = UDim.new(0, 10)
	overlayPad.Parent = overlay

	local panel = Instance.new("Frame")
	panel.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
	panel.BorderSizePixel = 0
	panel.Size = UDim2.new(1, 0, 0, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.Parent = overlay
	addCorner(panel, 10)
	local sizeLimit = Instance.new("UISizeConstraint")
	sizeLimit.MaxSize = Vector2.new(maxWidth or 360, 100000)
	sizeLimit.Parent = panel
	local panelPad = Instance.new("UIPadding")
	panelPad.PaddingLeft = UDim.new(0, 14)
	panelPad.PaddingRight = UDim.new(0, 14)
	panelPad.PaddingTop = UDim.new(0, 12)
	panelPad.PaddingBottom = UDim.new(0, 14)
	panelPad.Parent = panel
	addStack(panel, 8)

	local title = Instance.new("TextLabel")
	title.Text = titleText
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextSize = 14
	title.Font = Enum.Font.GothamSemibold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 24)
	title.LayoutOrder = 0
	title.Parent = panel

	local function close()
		overlay:Destroy()
	end
	return panel, close
end

