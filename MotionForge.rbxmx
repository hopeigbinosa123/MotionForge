-- ========== SMALL HELPERS ==========
local function deepCopy(orig)
	local copy = {}
	for k, v in pairs(orig) do
		if type(v) == "table" then
			copy[k] = deepCopy(v)
		else
			copy[k] = v
		end
	end
	return copy
end

local function clamp(n, lo, hi)
	return math.max(lo, math.min(hi, n))
end

local function toNum(v, default)
	local n = tonumber(v)
	if n == nil or n ~= n then
		return default
	end
	return n
end

-- 12.500 -> "12.5", 3.000 -> "3"
local function fmt(n)
	local s = string.format("%.3f", n)
	s = s:gsub("0+$", "")
	s = s:gsub("%.$", "")
	if s == "" or s == "-" or s == "-0" then
		s = "0"
	end
	return s
end

-- Safe Lua string literal (no raw newlines, quotes escaped)
local function luaStr(s)
	local q = string.format("%q", tostring(s or ""))
	q = q:gsub("\\\n", "\\n")
	return q
end

local function cleanFileName(name)
	local s = string.gsub(tostring(name or ""), "[^%w_]", "_")
	if s == "" then
		s = "Move"
	end
	return s
end

local function isPlaceholderSound(id)
	return id == nil or id == "" or string.find(id, "123456789", 1, true) ~= nil
end

-- "4,4,4" / "4 4 4" / "4" -> Vector3 (validated + clamped), or nil + reason
local function parseSize(text)
	local nums = {}
	for token in tostring(text or ""):gmatch("-?%d*%.?%d+") do
		nums[#nums + 1] = tonumber(token)
	end
	if #nums == 1 then
		nums = { nums[1], nums[1], nums[1] }
	end
	if #nums ~= 3 then
		return nil, "Hitbox size needs 3 numbers, like 4,4,4"
	end
	for i = 1, 3 do
		if nums[i] <= 0 then
			return nil, "Hitbox size values must be above 0"
		end
		nums[i] = clamp(nums[i], 0.5, 60)
	end
	return Vector3.new(nums[1], nums[2], nums[3])
end

local function sizeToString(v)
	return fmt(v.X) .. "," .. fmt(v.Y) .. "," .. fmt(v.Z)
end

-- "123456" -> "rbxassetid://123456"; returns "" for empty
local function normalizeAnimId(id)
	id = tostring(id or ""):gsub("%s+", "")
	if id == "" then
		return ""
	end
	if id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

-- ========== MOVE DATA ==========
local function newCutscene()
	return {
		Enabled = false,
		SlowMotion = false,
		SlowMotionFactor = 0.3,
		CameraShake = false,
		ShakeIntensity = 2,
		Zoom = false,
		ZoomAmount = 0.4,
		Duration = 0.5,
		CameraRotate = false,
		RotationAngle = 180,
		RotationSpeed = 180,
		RotationDirection = "clockwise",
	}
end

local function newMove()
	return {
		Name = "New Move",
		Cooldown = "2",
		AnimId = "",
		Damage = "15",
		Knockback = "50",
		Timeline = {},
		Cutscene = newCutscene(),
	}
end

local currentMove = newMove()
local selectedEvent = nil -- the Timeline entry whose hitbox the preview shows
local clipboardEvent = nil

-- Fill in anything an old save / template / pasted event is missing
local function normalizeEvent(event)
	event.time = clamp(toNum(event.time, 0), 0, 30)
	event.data = event.data or {}
	local d = event.data
	if event.type == "Hitbox" then
		d.damage = tostring(d.damage or "15")
		d.knockback = tostring(d.knockback or "50")
		d.hitboxSize = tostring(d.hitboxSize or "4,4,4")
		d.hitboxOffset = tostring(d.hitboxOffset or "3")
		d.active = tostring(d.active or "0.12")
	elseif event.type == "Sound" then
		d.soundId = tostring(d.soundId or PLACEHOLDER_SOUND)
	elseif event.type == "Effect" then
		d.effectType = tostring(d.effectType or "Basic Explosion")
	end
	return event
end

-- v1.6.0 and older used a 150-1000 knockback scale. Rescale those so they feel the same.
local function legacyKnockback(value, isLegacy)
	local n = toNum(value, 50)
	if isLegacy and n > 150 then
		n = math.floor(n / 10 + 0.5)
	end
	return tostring(n)
end

-- Turn any decoded save/template table into a complete, valid move
local function sanitizeMove(data)
	local m = newMove()
	local isLegacy = (data.Version ~= VERSION) and not data.IsCurrentScale
	m.Name = tostring(data.Name or m.Name)
	m.Cooldown = tostring(data.Cooldown or m.Cooldown)
	m.AnimId = tostring(data.AnimId or "")
	m.Damage = tostring(data.Damage or m.Damage)
	m.Knockback = legacyKnockback(data.Knockback, isLegacy)
	if type(data.Cutscene) == "table" then
		for k, v in pairs(data.Cutscene) do
			m.Cutscene[k] = v
		end
	end
	for _, event in ipairs(data.Timeline or {}) do
		local e = normalizeEvent(deepCopy(event))
		if e.type == "Hitbox" then
			e.data.knockback = legacyKnockback(e.data.knockback, isLegacy)
		end
		table.insert(m.Timeline, e)
	end
	table.sort(m.Timeline, function(a, b)
		return a.time < b.time
	end)
	return m
end

-- ========== TEMPLATES ==========
local function hit(time, dmg, kb, size, offset, active)
	return {
		time = time,
		type = "Hitbox",
		data = {
			damage = tostring(dmg),
			knockback = tostring(kb),
			hitboxSize = size,
			hitboxOffset = tostring(offset),
			active = tostring(active or 0.12),
		},
	}
end

local function snd(time)
	return { time = time, type = "Sound", data = { soundId = PLACEHOLDER_SOUND } }
end

local function fx(time, effectType)
	return { time = time, type = "Effect", data = { effectType = effectType } }
end

local function cutscene(overrides)
	local cs = newCutscene()
	for k, v in pairs(overrides) do
		cs[k] = v
	end
	return cs
end

