-- ========== CARD 7: TEMPLATE LIBRARY ==========
local function buildTemplateCard()
	local card = createCard("📚 Template Library", 7)

	local searchBox = Instance.new("TextBox")
	searchBox.PlaceholderText = "Search templates..."
	searchBox.PlaceholderColor3 = C.dim
	searchBox.Text = ""
	searchBox.TextColor3 = Color3.fromRGB(220, 220, 220)
	searchBox.TextSize = 12
	searchBox.Font = Enum.Font.Gotham
	searchBox.TextXAlignment = Enum.TextXAlignment.Left
	searchBox.ClearTextOnFocus = false
	searchBox.BackgroundColor3 = C.field
	searchBox.BorderSizePixel = 0
	searchBox.Size = UDim2.new(1, 0, 0, 30)
	searchBox.LayoutOrder = nextOrder(card)
	searchBox.Parent = card
	addCorner(searchBox, 6)
	local searchPad = Instance.new("UIPadding")
	searchPad.PaddingLeft = UDim.new(0, 8)
	searchPad.Parent = searchBox

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, 0, 0, 220)
	list.BackgroundColor3 = C.list
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.LayoutOrder = nextOrder(card)
	list.Parent = card
	addCorner(list, 8)
	addStack(list, 4)
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 4)
	listPad.PaddingBottom = UDim.new(0, 4)
	listPad.PaddingLeft = UDim.new(0, 4)
	listPad.PaddingRight = UDim.new(0, 4)
	listPad.Parent = list

	local function refresh()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local term = string.lower(searchBox.Text or "")
		local shown = 0
		local function consider(template)
			if term ~= "" and not string.find(string.lower(template.Name), term, 1, true)
				and not string.find(string.lower(template.Description or ""), term, 1, true) then
				return
			end
			shown = shown + 1

			local row = Instance.new("Frame")
			row.BackgroundColor3 = C.row
			row.BorderSizePixel = 0
			row.Size = UDim2.new(1, -4, 0, 70)
			row.LayoutOrder = shown
			row.Parent = list
			addCorner(row, 8)

			local icon = Instance.new("TextLabel")
			icon.Text = template.Icon or "📦"
			icon.TextSize = 24
			icon.BackgroundTransparency = 1
			icon.Size = UDim2.new(0, 46, 1, 0)
			icon.Parent = row

			local name = Instance.new("TextLabel")
			name.Text = template.Name
			name.TextColor3 = Color3.fromRGB(220, 220, 230)
			name.TextSize = 13
			name.Font = Enum.Font.GothamSemibold
			name.TextXAlignment = Enum.TextXAlignment.Left
			name.TextTruncate = Enum.TextTruncate.AtEnd
			name.BackgroundTransparency = 1
			name.Size = UDim2.new(1, -56, 0, 22)
			name.Position = UDim2.new(0, 50, 0, 4)
			name.Parent = row

			local desc = Instance.new("TextLabel")
			desc.Text = template.Description or ""
			desc.TextColor3 = Color3.fromRGB(140, 140, 150)
			desc.TextSize = 10
			desc.Font = Enum.Font.Gotham
			desc.TextXAlignment = Enum.TextXAlignment.Left
			desc.TextYAlignment = Enum.TextYAlignment.Top
			desc.TextWrapped = true
			desc.BackgroundTransparency = 1
			desc.Size = UDim2.new(1, -56, 0, 24)
			desc.Position = UDim2.new(0, 50, 0, 26)
			desc.Parent = row

			local loadButton = Instance.new("TextButton")
			styleButton(loadButton, "Load", C.blue, 11)
			loadButton.Size = UDim2.new(0, 52, 0, 22)
			loadButton.Position = UDim2.new(1, -58, 1, -26)
			loadButton.Parent = row
			loadButton.MouseButton1Click:Connect(function()
				loadTemplate(template)
			end)

			if template.IsCustom then
				local deleteButton = Instance.new("TextButton")
				styleButton(deleteButton, "🗑️", C.red, 11)
				deleteButton.Size = UDim2.new(0, 30, 0, 22)
				deleteButton.Position = UDim2.new(1, -94, 1, -26)
				deleteButton.Parent = row
				deleteButton.MouseButton1Click:Connect(function()
					removeCustomTemplate(template)
					refresh()
				end)
			end
		end

		for _, template in ipairs(builtInTemplates) do
			consider(template)
		end
		for _, template in ipairs(customTemplates) do
			consider(template)
		end

		if shown == 0 then
			local empty = Instance.new("TextLabel")
			empty.Text = "No templates found"
			empty.TextColor3 = C.dim
			empty.TextSize = 12
			empty.Font = Enum.Font.Gotham
			empty.BackgroundTransparency = 1
			empty.Size = UDim2.new(1, 0, 0, 40)
			empty.Parent = list
		end
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(refresh)
	UI.refreshTemplates = refresh

	addButtonRow(card, {
		{ "💾 Save as Template", C.purple, function()
			local panel, close = openDialog("Save as Template", 340)
			local _, nameBox = addRow(panel, "Name", currentMove.Name .. " (Template)")
			local _, descBox = addRow(panel, "Description", "Custom move template")
			local _, iconBox = addRow(panel, "Icon", "⭐")
			addButtonRow(panel, {
				{ "Save", C.blue, function()
					local name = nameBox.Text
					if name == "" then
						name = "Unnamed Template"
					end
					addCustomTemplate(name, descBox.Text, iconBox.Text ~= "" and iconBox.Text or "⭐")
					refresh()
					close()
					flashStatus("Template saved: " .. name, false)
				end },
				{ "Cancel", C.grey, close },
			})
		end },
		{ "🔄 Refresh", C.dark, refresh },
	})
	refresh()
end

-- ========== CARD 8: SAVE / LOAD ==========
local function buildSaveCard()
	local card = createCard("💾 Save / Load", 8)
	addButtonRow(card, {
		{ "💾 Save Current Move", C.blue, saveCurrentMove },
		{ "🆕 New Move", C.dark, function()
			applyMove(newMove())
			flashStatus("Started a new move (the previous one was not saved unless you saved it)", false)
		end },
	}, 36)

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, 0, 0, 140)
	list.BackgroundColor3 = C.list
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.LayoutOrder = nextOrder(card)
	list.Parent = card
	addCorner(list, 6)
	addStack(list, 4)
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 4)
	listPad.PaddingBottom = UDim.new(0, 4)
	listPad.PaddingLeft = UDim.new(0, 4)
	listPad.PaddingRight = UDim.new(0, 4)
	listPad.Parent = list

	UI.refreshMoves = function()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local names = getSavedMoveNames()
		if #names == 0 then
			local empty = Instance.new("TextLabel")
			empty.Text = "No saved moves"
			empty.TextColor3 = C.dim
			empty.TextSize = 12
			empty.Font = Enum.Font.Gotham
			empty.BackgroundTransparency = 1
			empty.Size = UDim2.new(1, 0, 0, 30)
			empty.Parent = list
			return
		end
		for index, moveName in ipairs(names) do
			local row = Instance.new("Frame")
			row.BackgroundColor3 = C.row
			row.BorderSizePixel = 0
			row.Size = UDim2.new(1, -4, 0, 32)
			row.LayoutOrder = index
			row.Parent = list
			addCorner(row, 4)

			local open = Instance.new("TextButton")
			open.Text = "📁 " .. moveName
			open.TextColor3 = Color3.fromRGB(210, 210, 215)
			open.TextSize = 12
			open.Font = Enum.Font.Gotham
			open.TextXAlignment = Enum.TextXAlignment.Left
			open.TextTruncate = Enum.TextTruncate.AtEnd
			open.BackgroundTransparency = 1
			open.Size = UDim2.new(1, -44, 1, 0)
			open.Position = UDim2.new(0, 8, 0, 0)
			open.Parent = row
			open.MouseButton1Click:Connect(function()
				loadMoveByName(moveName)
			end)

			local del = Instance.new("TextButton")
			styleButton(del, "🗑️", C.red, 12)
			del.Size = UDim2.new(0, 30, 0, 24)
			del.Position = UDim2.new(1, -34, 0, 4)
			del.Parent = row
			del.MouseButton1Click:Connect(function()
				deleteMoveByName(moveName)
			end)
		end
	end
	UI.refreshMoves()
	addNote(card, "Click a move to load it. Saved moves live in the plugin's settings, so they follow you between places.")
end

-- ========== BUILD EVERYTHING ==========
buildInfoCard()
buildAnimationCard()
buildCombatCard()
buildTimelineCard()
buildCutsceneCard()
buildExportCard()
buildTemplateCard()
buildSaveCard()

-- Reload every control from currentMove (after loading a move/template or starting a new one)
UI.syncAll = function()
	for _, fn in ipairs(syncers) do
		fn()
	end
end
UI.syncAll()
updateStatus()

-- ========== CLEANUP ==========
local function cleanupAll()
	stopAllPreviews()
	clearPreview()
	if previewDummy then
		previewDummy:Destroy()
		previewDummy = nil
		previewAnimator = nil
		previewAnimTrack = nil
		loadedAnimId = nil
	end
end

mainGui:GetPropertyChangedSignal("Enabled"):Connect(function()
	toolbarButton:SetActive(mainGui.Enabled)
	if not mainGui.Enabled then
		cleanupAll()
		visualizerActive = false
		if UI.visButton then
			UI.visButton.Text = "👁️ Hitbox Preview: OFF"
			UI.visButton.BackgroundColor3 = C.purple
		end
	end
end)

plugin.Unloading:Connect(cleanupAll)

-- ========== LAUNCH ==========
cleanStaleDummies()
mainGui.Enabled = true
toolbarButton:SetActive(true)

toolbarButton.Click:Connect(function()
	mainGui.Enabled = not mainGui.Enabled
end)

