-- ========== EVENT DIALOGS ==========
local function openEventDialog(event)
	local panel, close = openDialog("Edit " .. event.type .. " Event", 360)
	local d = event.data
	local _, timeBox = addRow(panel, "Time (sec)", string.format("%.2f", event.time))

	local boxes = {}
	local effectType = d.effectType
	if event.type == "Hitbox" then
		local _, damage = addRow(panel, "Damage", d.damage)
		local _, knockback = addRow(panel, "Knockback", d.knockback)
		local _, size = addRow(panel, "Hitbox Size", d.hitboxSize)
		local _, offset = addRow(panel, "Offset (forward)", d.hitboxOffset)
		local _, active = addRow(panel, "Active (sec)", d.active)
		boxes = { damage = damage, knockback = knockback, size = size, offset = offset, active = active }
		addNote(panel, "Size = X,Y,Z studs. Offset = studs in front of the fighter's root part. Active = how long the hitbox stays live.")
	elseif event.type == "Sound" then
		local _, sound = addRow(panel, "Sound ID", d.soundId)
		boxes.sound = sound
	elseif event.type == "Effect" then
		local effectButton = addButton(panel, "✨ " .. tostring(effectType) .. "  (click to change)", C.dark, 32, nil)
		effectButton.MouseButton1Click:Connect(function()
			local index = table.find(EFFECT_NAMES, effectType) or 0
			effectType = EFFECT_NAMES[index % #EFFECT_NAMES + 1]
			effectButton.Text = "✨ " .. effectType .. "  (click to change)"
		end)
	end

	local errorLabel = addLabel(panel, "", 11, C.err)

	addButtonRow(panel, {
		{ "Save Changes", C.blue, function()
			local newTime = tonumber(timeBox.Text)
			if not newTime or newTime < 0 or newTime > 30 then
				errorLabel.Text = "Time must be a number from 0 to 30"
				return
			end
			local newData = {}
			if event.type == "Hitbox" then
				local size = parseSize(boxes.size.Text)
				if not size then
					errorLabel.Text = select(2, parseSize(boxes.size.Text))
					return
				end
				local damage = tonumber(boxes.damage.Text)
				local knockback = tonumber(boxes.knockback.Text)
				local offset = tonumber(boxes.offset.Text)
				local active = tonumber(boxes.active.Text)
				if not damage or damage < 0 then
					errorLabel.Text = "Damage must be a number, 0 or more"
					return
				end
				if not knockback or knockback < 0 then
					errorLabel.Text = "Knockback must be a number, 0 or more"
					return
				end
				if not offset then
					errorLabel.Text = "Offset must be a number (e.g. 3)"
					return
				end
				if not active or active <= 0 then
					errorLabel.Text = "Active time must be above 0 (e.g. 0.12)"
					return
				end
				newData = {
					damage = fmt(clamp(damage, 0, 10000)),
					knockback = fmt(clamp(knockback, 0, 300)),
					hitboxSize = sizeToString(size),
					hitboxOffset = fmt(clamp(offset, -10, 30)),
					active = fmt(clamp(active, 0.03, 2)),
				}
			elseif event.type == "Sound" then
				newData = { soundId = boxes.sound.Text }
			else
				newData = { effectType = effectType }
			end
			event.time = newTime
			event.data = newData
			sortTimeline()
			if UI.refreshEvents then
				UI.refreshEvents()
			end
			updateStatus()
			refreshVisualizer()
			close()
		end },
		{ "Cancel", C.grey, close },
	})
end

local function openAddEventDialog()
	local panel, close = openDialog("Select Event Type", 300)
	local function add(eventType, data)
		close()
		selectedEvent = addEvent(eventType, nextEventTime(), data)
		if UI.refreshEvents then
			UI.refreshEvents()
		end
		updateStatus()
		refreshVisualizer()
	end
	addButton(panel, "🔴 Hitbox (Damage)", C.dark, 36, function()
		add("Hitbox", {
			damage = currentMove.Damage,
			knockback = currentMove.Knockback,
			hitboxSize = "4,4,4",
			hitboxOffset = "3",
			active = "0.12",
		})
	end)
	addButton(panel, "🔊 Sound Effect", C.dark, 36, function()
		add("Sound", { soundId = PLACEHOLDER_SOUND })
	end)
	addButton(panel, "✨ Visual Effect", C.dark, 36, function()
		add("Effect", { effectType = "Basic Explosion" })
	end)
	addButton(panel, "Cancel", C.grey, 32, close)
end

-- ========== CARD 4: TIMELINE ==========
local function buildTimelineCard()
	local card = createCard("⏱️ Timeline", 4)

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, 0, 0, 170)
	list.BackgroundColor3 = C.list
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 6
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.LayoutOrder = nextOrder(card)
	list.Parent = card
	addCorner(list, 8)
	local listLayout = addStack(list, 4)
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 4)
	listPad.PaddingBottom = UDim.new(0, 4)
	listPad.PaddingLeft = UDim.new(0, 4)
	listPad.PaddingRight = UDim.new(0, 4)
	listPad.Parent = list

	local function smallButton(row, text, color, xOffset)
		local btn = Instance.new("TextButton")
		styleButton(btn, text, color, 12)
		btn.Size = UDim2.new(0, 28, 0, 26)
		btn.Position = UDim2.new(1, xOffset, 0, 5)
		btn.Parent = row
		return btn
	end

	UI.refreshEvents = function()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		if #currentMove.Timeline == 0 then
			local empty = Instance.new("TextLabel")
			empty.Text = "No events yet. Click '+ Add Event'."
			empty.TextColor3 = C.dim
			empty.TextSize = 11
			empty.Font = Enum.Font.Gotham
			empty.BackgroundTransparency = 1
			empty.Size = UDim2.new(1, 0, 0, 40)
			empty.Parent = list
			return
		end

		for index, event in ipairs(currentMove.Timeline) do
			local row = Instance.new("Frame")
			row.BackgroundColor3 = (event == selectedEvent) and Color3.fromRGB(60, 70, 95) or C.row
			row.BorderSizePixel = 0
			row.Size = UDim2.new(1, -4, 0, 36)
			row.LayoutOrder = index
			row.Parent = list
			addCorner(row, 6)

			local label = Instance.new("TextButton")
			label.Text = formatEventText(event)
			label.TextColor3 = Color3.fromRGB(210, 210, 215)
			label.TextSize = 11
			label.Font = Enum.Font.Gotham
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextTruncate = Enum.TextTruncate.AtEnd
			label.BackgroundTransparency = 1
			label.AutoButtonColor = false
			label.Size = UDim2.new(1, -104, 1, 0)
			label.Position = UDim2.new(0, 8, 0, 0)
			label.Parent = row
			label.MouseButton1Click:Connect(function()
				selectedEvent = event
				UI.refreshEvents()
				refreshVisualizer()
			end)

			local copyButton = smallButton(row, "📋", Color3.fromRGB(50, 100, 180), -96)
			copyButton.MouseButton1Click:Connect(function()
				clipboardEvent = deepCopy(event)
				flashStatus("Copied " .. event.type .. " event", false)
			end)

			local editButton = smallButton(row, "✏️", C.grey, -64)
			editButton.MouseButton1Click:Connect(function()
				openEventDialog(event)
			end)

			local deleteButton = smallButton(row, "🗑️", C.red, -32)
			deleteButton.MouseButton1Click:Connect(function()
				removeEvent(index)
				UI.refreshEvents()
				updateStatus()
				refreshVisualizer()
			end)
		end
	end

	addNote(card, "Click an event to preview that hitbox. ✏️ edits, 📋 copies, 🗑️ deletes.")
	addButtonRow(card, {
		{ "+ Add Event", C.blue, openAddEventDialog },
		{ "📌 Paste Event", C.dark, function()
			if not clipboardEvent then
				flashStatus("Nothing to paste. Copy an event first.", true)
				return
			end
			local event = normalizeEvent(deepCopy(clipboardEvent))
			event.time = nextEventTime()
			table.insert(currentMove.Timeline, event)
			sortTimeline()
			selectedEvent = event
			UI.refreshEvents()
			updateStatus()
			refreshVisualizer()
		end },
	})
	UI.visButton = addButton(card, "👁️ Hitbox Preview: OFF", C.purple, 32, toggleVisualizer)
	table.insert(syncers, function()
		UI.refreshEvents()
	end)
	UI.refreshEvents()
end

-- ========== CARD 5: CUTSCENE ==========
local function buildCutsceneCard()
	local card = createCard("🎥 Cutscene", 5)
	local cs = function()
		return currentMove.Cutscene
	end

	local masterButton = addButton(card, "", C.grey, 36, nil)
	local function refreshMaster()
		local on = cs().Enabled
		masterButton.Text = on and "✅ Cutscene Effects: ON" or "⬜ Cutscene Effects: OFF"
		masterButton.BackgroundColor3 = on and C.blue or C.grey
	end
	masterButton.MouseButton1Click:Connect(function()
		cs().Enabled = not cs().Enabled
		refreshMaster()
	end)
	refreshMaster()
	table.insert(syncers, refreshMaster)

	local function toggle(label, key)
		table.insert(syncers, addToggleRow(card, label, function()
			return cs()[key] == true
		end, function(value)
			cs()[key] = value
		end))
	end
	local function number(label, key, lo, hi)
		table.insert(syncers, addNumberRow(card, label, function()
			return toNum(cs()[key], 0)
		end, function(value)
			cs()[key] = value
		end, lo, hi))
	end

	number("Duration (sec)", "Duration", 0.1, 10)
	toggle("Slow Motion", "SlowMotion")
	number("  Slow factor", "SlowMotionFactor", 0.05, 1)
	toggle("Camera Shake", "CameraShake")
	number("  Shake intensity", "ShakeIntensity", 0, 20)
	toggle("Zoom Effect", "Zoom")
	number("  Zoom amount", "ZoomAmount", 0, 0.8)
	toggle("Camera Rotate", "CameraRotate")
	number("  Angle (deg)", "RotationAngle", 0, 720)
	number("  Speed (deg/sec)", "RotationSpeed", 10, 1440)

	local directionButton = addButton(card, "", C.dark, 30, nil)
	local function refreshDirection()
		directionButton.Text = "↻ Direction: " .. tostring(cs().RotationDirection or "clockwise")
	end
	directionButton.MouseButton1Click:Connect(function()
		cs().RotationDirection = (cs().RotationDirection == "counter") and "clockwise" or "counter"
		refreshDirection()
	end)
	refreshDirection()
	table.insert(syncers, refreshDirection)

	addNote(card, "The camera swings out to the angle and back, so it never snaps. Slow motion slows the move's animation only; hit timing stays real-time. Effects play on the player's own client.")
	addButtonRow(card, {
		{ "🎬 Preview Cutscene", C.green, previewCutscene },
		{ "⏹️ Stop", C.red, stopAllPreviews },
	})
end

