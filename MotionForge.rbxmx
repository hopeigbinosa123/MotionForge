local customTemplates = {}

local function loadCustomTemplates()
	local raw = plugin:GetSetting("MotionForge_CustomTemplates")
	if raw and raw ~= "" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if ok and type(decoded) == "table" then
			for _, template in ipairs(decoded) do
				if type(template) == "table" and type(template.Data) == "table" then
					table.insert(customTemplates, template)
				end
			end
		end
	end
end

local function saveCustomTemplates()
	pcall(function()
		plugin:SetSetting("MotionForge_CustomTemplates", HttpService:JSONEncode(customTemplates))
	end)
end

local function addCustomTemplate(name, description, icon)
	local data = deepCopy(currentMove)
	data.Version = VERSION
	table.insert(customTemplates, {
		Name = name,
		Description = (description and description ~= "") and description or "Custom move template",
		Icon = icon or "⭐",
		IsCustom = true,
		Data = data,
	})
	saveCustomTemplates()
end

local function removeCustomTemplate(template)
	local index = table.find(customTemplates, template)
	if index then
		table.remove(customTemplates, index)
		saveCustomTemplates()
	end
end

loadCustomTemplates()

-- ========== UI REFERENCES (filled in as the UI is built) ==========
local UI = {}
local statusToken = 0

local function updateStatus()
	if UI.status then
		UI.status.TextColor3 = C.status
		UI.status.Text = string.format("Editing: %s | Dmg: %s | CD: %ss | Events: %d",
			currentMove.Name, currentMove.Damage, currentMove.Cooldown, #currentMove.Timeline)
	end
end

-- Non-blocking status message that returns to the normal line after a moment
local function flashStatus(text, isError)
	if not UI.status then
		return
	end
	statusToken = statusToken + 1
	local mine = statusToken
	UI.status.Text = text
	UI.status.TextColor3 = isError and C.err or C.ok
	task.delay(isError and 3.5 or 2.2, function()
		if statusToken == mine then
			updateStatus()
		end
	end)
end

-- ========== TIMELINE FUNCTIONS ==========
local function sortTimeline()
	table.sort(currentMove.Timeline, function(a, b)
		return a.time < b.time
	end)
end

local function nextEventTime()
	local last = currentMove.Timeline[#currentMove.Timeline]
	if last then
		return last.time + 0.3
	end
	return 0.2
end

local function addEvent(eventType, time, data)
	local event = normalizeEvent({ type = eventType, time = time, data = data or {} })
	table.insert(currentMove.Timeline, event)
	sortTimeline()
	return event
end

local function removeEvent(index)
	if currentMove.Timeline[index] == selectedEvent then
		selectedEvent = nil
	end
	table.remove(currentMove.Timeline, index)
end

local function getEventIcon(eventType)
	if eventType == "Hitbox" then
		return "🔴"
	elseif eventType == "Sound" then
		return "🔊"
	elseif eventType == "Effect" then
		return "✨"
	end
	return "📌"
end

local function formatEventText(event)
	local icon = getEventIcon(event.type)
	local timeStr = string.format("%.2f", event.time)
	local d = event.data
	if event.type == "Hitbox" then
		return string.format("%s %ss  Dmg %s  KB %s  %s @%s  %ss", icon, timeStr, d.damage or "?", d.knockback or "?",
			d.hitboxSize or "?", d.hitboxOffset or "?", d.active or "?")
	elseif event.type == "Sound" then
		return string.format("%s %ss  Sound", icon, timeStr)
	elseif event.type == "Effect" then
		return string.format("%s %ss  %s", icon, timeStr, d.effectType or "Effect")
	end
	return string.format("%s %ss  %s", icon, timeStr, event.type)
end

-- ========== PREVIEW DUMMY ==========
local previewDummy = nil
local previewAnimator = nil
local previewAnimTrack = nil
local loadedAnimId = nil
local creatingDummy = false

local previewSettings = { PlaybackSpeed = 1.0 }
local SPEEDS = { 0.25, 0.5, 1, 1.5, 2 }

local function getDummyRoot()
	if previewDummy and previewDummy.Parent then
		return previewDummy:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

local function cleanStaleDummies()
	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name == DUMMY_NAME then
			child:Destroy()
		end
	end
end

local function createPreviewDummy()
	if previewDummy and previewDummy.Parent then
		return previewDummy
	end
	if creatingDummy then
		while creatingDummy do
			task.wait()
		end
		return previewDummy
	end
	creatingDummy = true

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		creatingDummy = false
		flashStatus("Couldn't create the R15 dummy", true)
		return nil
	end

	model.Name = DUMMY_NAME
	local camera = workspace.CurrentCamera
	if camera then
		-- 15 studs in front of the camera, turned sideways so you see the hitbox reach from the side
		local position = camera.CFrame.Position + camera.CFrame.LookVector * 15 - Vector3.new(0, 2, 0)
		model:PivotTo(CFrame.lookAt(position, position + camera.CFrame.RightVector))
	end
	model.Parent = workspace
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = true
	end
	previewDummy = model

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		previewAnimator = humanoid:FindFirstChildOfClass("Animator")
		if not previewAnimator then
			previewAnimator = Instance.new("Animator")
			previewAnimator.Parent = humanoid
		end
	end
	previewAnimTrack = nil
	loadedAnimId = nil
	creatingDummy = false
	flashStatus("R15 dummy created", false)
	return previewDummy
end

-- ========== HITBOX VISUALIZER (drawn on the dummy) ==========
local visualizerActive = false
local currentPreviewParts = {}
local flashParts = {}

local function clearPreview()
	for _, part in ipairs(currentPreviewParts) do
		if part and part.Parent then
			part:Destroy()
		end
	end
	currentPreviewParts = {}
end

local function clearFlashes()
	for _, part in ipairs(flashParts) do
		if part and part.Parent then
			part:Destroy()
		end
	end
	flashParts = {}
end

local function makeBoxPart(size, cframe, color, transparency)
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = transparency
	part.Color = color
	part.Material = Enum.Material.Neon
	local box = Instance.new("SelectionBox")
	box.Adornee = part
	box.Color3 = color
	box.LineThickness = 0.04
	box.Transparency = 0.2
	box.Parent = part
	part.Parent = workspace.CurrentCamera or workspace
	return part
end

-- Box for one hitbox event, placed relative to the dummy's facing direction
local function hitboxCFrame(event)
	local d = event.data
	local offset = clamp(toNum(d.hitboxOffset, 3), -10, 30)
	local root = getDummyRoot()
	if root then
		return root.CFrame * CFrame.new(0, 0, -offset)
	end
	local camera = workspace.CurrentCamera
	if camera then
		return CFrame.new(camera.CFrame.Position + camera.CFrame.LookVector * (10 + offset))
	end
	return CFrame.new(0, 5, 0)
end

local function pickPreviewEvent()
	if selectedEvent and table.find(currentMove.Timeline, selectedEvent) and selectedEvent.type == "Hitbox" then
		return selectedEvent
	end
	for _, event in ipairs(currentMove.Timeline) do
		if event.type == "Hitbox" then
			return event
		end
	end
	return nil
end

local function updateHitboxVisualizer()
	clearPreview()
	if not visualizerActive then
		return
	end
	local event = pickPreviewEvent()
	if not event then
		return
	end
	local size = parseSize(event.data.hitboxSize) or Vector3.new(4, 4, 4)
	local damage = clamp(toNum(event.data.damage, 15), 1, 100)
	local color = Color3.fromRGB(255 * (damage / 100), 255 * (1 - damage / 100), 0)
	table.insert(currentPreviewParts, makeBoxPart(size, hitboxCFrame(event), color, 0.6))
end

local function flashHitbox(event, seconds)
	local size = parseSize(event.data.hitboxSize) or Vector3.new(4, 4, 4)
	local part = makeBoxPart(size, hitboxCFrame(event), Color3.fromRGB(255, 60, 60), 0.35)
	table.insert(flashParts, part)
	task.delay(math.max(seconds, 0.12), function()
		if part and part.Parent then
			part:Destroy()
		end
	end)
end

local function refreshVisualizer()
	if visualizerActive then
		updateHitboxVisualizer()
	end
end

local function toggleVisualizer()
	visualizerActive = not visualizerActive
	if UI.visButton then
		UI.visButton.Text = visualizerActive and "👁️ Hitbox Preview: ON" or "👁️ Hitbox Preview: OFF"
		UI.visButton.BackgroundColor3 = visualizerActive and C.blue or C.purple
	end
	if visualizerActive then
		createPreviewDummy()
		updateHitboxVisualizer()
		flashStatus("Hitbox preview ON (click an event to preview that hitbox)", false)
	else
		clearPreview()
		flashStatus("Hitbox preview OFF", false)
	end
end

-- ========== ANIMATION + TIMELINE PREVIEW ==========
local previewRunId = 0
local previewPlaying = false

local function stopPreview()
	previewRunId = previewRunId + 1
	previewPlaying = false
	if previewAnimTrack then
		pcall(function()
			previewAnimTrack:Stop(0)
		end)
	end
	clearFlashes()
end

local function loadAnimationOnDummy()
	local animId = normalizeAnimId(currentMove.AnimId)
	if animId == "" then
		return false
	end
	if not createPreviewDummy() or not previewAnimator then
		return false
	end
	if previewAnimTrack and loadedAnimId == animId then
		return true
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = animId
	local ok, track = pcall(function()
		return previewAnimator:LoadAnimation(animation)
	end)
	if not ok or not track then
		flashStatus("Animation failed to load", true)
		return false
	end

	local started = os.clock()
	while track.Length == 0 and os.clock() - started < 4 do
		task.wait(0.1)
	end
	if track.Length == 0 then
		flashStatus("Animation didn't load. Check the ID and that you own it.", true)
		return false
	end

	previewAnimTrack = track
	loadedAnimId = animId
	flashStatus(string.format("Animation loaded: %.2fs", track.Length), false)
	return true
end

local function timelineLength()
	local length = 0
	for _, event in ipairs(currentMove.Timeline) do
		local extra = 0.1
		if event.type == "Hitbox" then
			extra = toNum(event.data.active, 0.12)
		end
		length = math.max(length, event.time + extra)
	end
	return length
end

-- Plays the animation on the dummy and flashes every hitbox at its event time.
local function playPreview()
	createPreviewDummy()
	stopPreview()
	local speed = previewSettings.PlaybackSpeed
	local runId = previewRunId

	local hasAnim = loadAnimationOnDummy()
	if runId ~= previewRunId then
		return
	end
	if hasAnim and previewAnimTrack then
		previewAnimTrack.Looped = false
		previewAnimTrack:Play(0.1, 1, speed)
	end

	previewPlaying = true
	for _, event in ipairs(currentMove.Timeline) do
		if event.type == "Hitbox" then
			task.delay(event.time / speed, function()
				if runId == previewRunId then
					flashHitbox(event, toNum(event.data.active, 0.12) / speed)
				end
			end)
		end
	end

	local length = timelineLength()
	if hasAnim and previewAnimTrack then
		length = math.max(length, previewAnimTrack.Length)
	end
	task.delay(length / speed + 0.2, function()
		if runId == previewRunId then
			previewPlaying = false
		end
	end)
	if not hasAnim then
		flashStatus("No animation loaded: previewing hitbox timing only", false)
	end
end

-- ========== CUTSCENE PREVIEW (edit-mode camera) ==========
-- Same maths as MotionForge_Cutscene, but uses a stored base camera because the Studio camera
-- doesn't reset itself every frame like the in-game camera does.
local cutsceneConn = nil
local cutsceneBase = nil
local cutsceneRunId = 0

local function stopCutscenePreview()
	cutsceneRunId = cutsceneRunId + 1
	if cutsceneConn then
		cutsceneConn:Disconnect()
		cutsceneConn = nil
	end
	local camera = workspace.CurrentCamera
	if cutsceneBase and camera then
		camera.CFrame = cutsceneBase.cframe
		camera.FieldOfView = cutsceneBase.fov
	end
	cutsceneBase = nil
	if previewAnimTrack then
		pcall(function()
			previewAnimTrack:AdjustSpeed(previewSettings.PlaybackSpeed)
		end)
	end
end

local function startCutsceneEffect()
	local cs = currentMove.Cutscene
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	stopCutscenePreview()
	local runId = cutsceneRunId

	local duration = clamp(toNum(cs.Duration, 0.5), 0.05, 10)
	local shakeAmount = clamp(toNum(cs.ShakeIntensity, 2), 0, 20)
	local zoomAmount = clamp(toNum(cs.ZoomAmount, 0.4), 0, 0.8)
	local angle = clamp(toNum(cs.RotationAngle, 180), 0, 720)
	local speed = clamp(toNum(cs.RotationSpeed, 180), 10, 1440)
	local direction = cs.RotationDirection == "counter" and -1 or 1
	local rotateTime = cs.CameraRotate and (angle * 2 / speed) or 0
	local total = math.max(duration, rotateTime)
	local root = getDummyRoot()

	cutsceneBase = { cframe = camera.CFrame, fov = camera.FieldOfView }
	local base = cutsceneBase
	local startTime = os.clock()

	if cs.SlowMotion and previewAnimTrack and previewAnimTrack.IsPlaying then
		previewAnimTrack:AdjustSpeed(clamp(toNum(cs.SlowMotionFactor, 0.3), 0.05, 1) * previewSettings.PlaybackSpeed)
	end

	cutsceneConn = RunService.RenderStepped:Connect(function()
		if runId ~= cutsceneRunId then
			return
		end
		local elapsed = os.clock() - startTime
		if elapsed >= total then
			stopCutscenePreview()
			return
		end

		local cframe = base.cframe
		if cs.CameraRotate and root and elapsed < rotateTime then
			local swing = math.rad(angle * direction * math.sin(math.pi * elapsed / rotateTime))
			local pivot = root.Position
			local offset = base.cframe.Position - pivot
			local rotated = CFrame.Angles(0, swing, 0):VectorToWorldSpace(offset)
			cframe = CFrame.lookAt(pivot + rotated, pivot)
		end
		if cs.CameraShake and elapsed < duration then
			local amplitude = shakeAmount * 0.1 * (1 - elapsed / duration)
			cframe = cframe * CFrame.new((math.random() * 2 - 1) * amplitude, (math.random() * 2 - 1) * amplitude, 0)
		end
		camera.CFrame = cframe

		if cs.Zoom and elapsed < duration then
			camera.FieldOfView = base.fov * (1 - zoomAmount * math.sin(math.pi * elapsed / duration))
		else
			camera.FieldOfView = base.fov
		end
	end)
end

-- Plays the move preview and starts the camera effect at the first hitbox, like the game does.
local function previewCutscene()
	if not currentMove.Cutscene.Enabled then
		flashStatus("Turn Cutscene Effects ON first", true)
		return
	end
	playPreview()
	local firstHit = 0
	for _, event in ipairs(currentMove.Timeline) do
		if event.type == "Hitbox" then
			firstHit = event.time
			break
		end
	end
	local runId = previewRunId
	task.delay(firstHit / previewSettings.PlaybackSpeed, function()
		if runId == previewRunId then
			startCutsceneEffect()
		end
	end)
end

local function stopAllPreviews()
	stopPreview()
	stopCutscenePreview()
end

-- ========== RUNTIME SOURCES (written into the game on export) ==========
-- These three scripts are what actually runs in your game. They are plain strings here,
-- and exportToGame() writes them into ReplicatedStorage / StarterPlayerScripts.

local HITBOX_SOURCE = [===[
-- Runtime used by every exported move. Re-exporting from MotionForge overwrites this file.
-- Server side: hitboxes, damage, knockback, sounds, effects, animation, hooks.
-- Client side: cutscene camera effects (see MotionForge_Cutscene). The server only sends
-- a RemoteEvent to the player who used the move.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local HitboxSystem = {}
HitboxSystem.__index = HitboxSystem
HitboxSystem.Version = "1.6.1"

-- ---------------------------------------------------------------- Signal
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local connection = { Connected = true, _fn = fn, _signal = self }
	function connection:Disconnect()
		self.Connected = false
		local list = self._signal._handlers
		local index = table.find(list, self)
		if index then
			table.remove(list, index)
		end
	end
	table.insert(self._handlers, connection)
	return connection
end

function Signal:Once(fn)
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, connection in ipairs(table.clone(self._handlers)) do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

HitboxSystem.Signal = Signal

-- ---------------------------------------------------------------- Knockback
-- strength = studs/second of velocity change (30 weak, 50 normal, 100 launcher).
-- Needs the target's physics to be owned by the server (SetNetworkOwner(nil)) to be reliable.
function HitboxSystem.ApplyKnockback(rootPart, direction, strength)
	if not rootPart or rootPart.Anchored or not strength or strength <= 0 then
		return
	end
	local push = direction * strength + Vector3.new(0, strength * 0.25, 0)
	rootPart:ApplyImpulse(push * rootPart.AssemblyMass)
end

-- ---------------------------------------------------------------- Hitbox
function HitboxSystem.new(character, data)
	data = data or {}
	local self = setmetatable({}, HitboxSystem)
	self.Character = character
	self.Humanoid = character:FindFirstChildOfClass("Humanoid")
	self.RootPart = character:FindFirstChild("HumanoidRootPart")
	self.Damage = tonumber(data.Damage) or 10
	self.Knockback = tonumber(data.Knockback) or 50
	local size = data.Size
	if typeof(size) ~= "Vector3" then
		size = Vector3.new(4, 4, 4)
	end
	self.Size = size
	self.Offset = tonumber(data.Offset) or 3
	self.Duration = math.max(tonumber(data.Duration) or 0.12, 0.03)
	self.OnHit = data.OnHit
	self.CanHit = data.CanHit
	self.HitTargets = {}
	self.Hits = 0
	self.Cancelled = false
	self.Fired = false
	return self
end

function HitboxSystem:Cancel()
	self.Cancelled = true
end

function HitboxSystem:_hit(model, humanoid)
	local targetRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	local origin = self.RootPart.Position
	local direction = Vector3.zero
	if targetRoot then
		local flat = (targetRoot.Position - origin) * Vector3.new(1, 0, 1)
		if flat.Magnitude > 0.01 then
			direction = flat.Unit
		end
	end
	if direction == Vector3.zero then
		direction = self.RootPart.CFrame.LookVector
	end

	self.Hits = self.Hits + 1
	local info = {
		Attacker = self.Character,
		Character = model,
		Humanoid = humanoid,
		RootPart = targetRoot,
		Position = targetRoot and targetRoot.Position or origin,
		Direction = direction,
		Damage = self.Damage,
		Knockback = self.Knockback,
		HitIndex = self.Hits,
	}

	-- OnHit may edit info.Damage / info.Knockback, or return false to skip the built-in damage + knockback.
	local applyDefault = true
	if self.OnHit then
		local ok, result = pcall(self.OnHit, info)
		if not ok then
			warn("[MotionForge] OnHit error: " .. tostring(result))
		elseif result == false then
			applyDefault = false
		end
	end

	if applyDefault then
		humanoid:TakeDamage(info.Damage)
		HitboxSystem.ApplyKnockback(targetRoot, direction, info.Knockback)
	end
end

-- Polls the box every frame for `Duration` seconds. Each target is hit once.
function HitboxSystem:Fire()
	if self.Fired or not self.RootPart then
		return
	end
	self.Fired = true

	task.spawn(function()
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { self.Character }
		params.MaxParts = 100

		local endTime = os.clock() + self.Duration
		repeat
			if self.Cancelled or not self.RootPart.Parent then
				break
			end
			local cframe = self.RootPart.CFrame * CFrame.new(0, 0, -self.Offset)
			for _, part in ipairs(workspace:GetPartBoundsInBox(cframe, self.Size, params)) do
				local model = part:FindFirstAncestorOfClass("Model")
				local humanoid = model and model:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 and not self.HitTargets[model] then
					self.HitTargets[model] = true
					local allowed = true
					if self.CanHit then
						local ok, result = pcall(self.CanHit, model)
						allowed = ok and result ~= false
					end
					if allowed then
						self:_hit(model, humanoid)
					end
				end
			end
			RunService.Heartbeat:Wait()
		until os.clock() >= endTime
	end)
end

-- ---------------------------------------------------------------- Sound
local function isPlaceholderSound(id)
	return type(id) ~= "string" or id == "" or string.find(id, "123456789", 1, true) ~= nil
end

function HitboxSystem.PlaySound(character, soundId)
	if isPlaceholderSound(soundId) then
		return
	end
	local parent = character:FindFirstChild("HumanoidRootPart") or character
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Parent = parent
	sound:Play()
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	Debris:AddItem(sound, 10)
end

-- ---------------------------------------------------------------- Effects (placeholder visuals)
local function newGhost(size, color, cframe, shape)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Size = size
	part.CFrame = cframe
	if shape then
		part.Shape = shape
	end
	part.Parent = workspace
	return part
end

local function fade(part, seconds, goal)
	goal = goal or {}
	goal.Transparency = 1
	TweenService:Create(part, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	Debris:AddItem(part, seconds + 0.2)
end

local function sparks(position, color, amount)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = position
	anchor.Parent = workspace
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new(1.5, 0)
	emitter.Lifetime = NumberRange.new(0.3, 0.6)
	emitter.Speed = NumberRange.new(15, 35)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.LightEmission = 1
	emitter.Parent = anchor
	emitter:Emit(amount)
	Debris:AddItem(anchor, 1.5)
end

local function groundPoint(root, forward)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { root.Parent }
	local origin = root.Position + root.CFrame.LookVector * forward
	local result = workspace:Raycast(origin, Vector3.new(0, -12, 0), params)
	if result then
		return result.Position
	end
	return origin - Vector3.new(0, 3, 0)
end

local Effects = {}

Effects["Basic Explosion"] = function(root)
	local part = newGhost(Vector3.new(1, 1, 1), Color3.fromRGB(255, 170, 60), root.CFrame * CFrame.new(0, 0, -3), Enum.PartType.Ball)
	fade(part, 0.35, { Size = Vector3.new(8, 8, 8) })
end

Effects["Fire Explosion"] = function(root)
	local cframe = root.CFrame * CFrame.new(0, 0, -4)
	local outer = newGhost(Vector3.new(2, 2, 2), Color3.fromRGB(255, 90, 20), cframe, Enum.PartType.Ball)
	fade(outer, 0.5, { Size = Vector3.new(12, 12, 12) })
	local core = newGhost(Vector3.new(1, 1, 1), Color3.fromRGB(255, 220, 120), cframe, Enum.PartType.Ball)
	fade(core, 0.3, { Size = Vector3.new(6, 6, 6) })
	sparks(cframe.Position, Color3.fromRGB(255, 140, 40), 30)
end

Effects["Energy Beam"] = function(root)
	local length = 40
	local cframe = root.CFrame * CFrame.new(0, 0, -(length / 2 + 2)) * CFrame.Angles(0, math.pi / 2, 0)
	local beam = newGhost(Vector3.new(length, 3, 3), Color3.fromRGB(80, 200, 255), cframe, Enum.PartType.Cylinder)
	fade(beam, 0.45, { Size = Vector3.new(length, 0.3, 0.3) })
end

Effects["Ground Crack"] = function(root)
	local ground = groundPoint(root, 3)
	local cframe = CFrame.new(ground + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	local disc = newGhost(Vector3.new(0.3, 4, 4), Color3.fromRGB(90, 80, 70), cframe, Enum.PartType.Cylinder)
	disc.Material = Enum.Material.Slate
	fade(disc, 1, { Size = Vector3.new(0.3, 16, 16) })
	sparks(ground, Color3.fromRGB(170, 150, 120), 20)
end

Effects["Shockwave"] = function(root)
	local ground = groundPoint(root, 0)
	local cframe = CFrame.new(ground + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	local ring = newGhost(Vector3.new(0.4, 3, 3), Color3.fromRGB(255, 255, 255), cframe, Enum.PartType.Cylinder)
	fade(ring, 0.5, { Size = Vector3.new(0.4, 24, 24) })
end

function HitboxSystem.PlayEffect(character, effectType)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local effect = Effects[effectType] or Effects["Basic Explosion"]
	local ok, err = pcall(effect, root)
	if not ok then
		warn("[MotionForge] Effect error: " .. tostring(err))
	end
end

-- ---------------------------------------------------------------- Move handle
local Handle = {}
Handle.__index = Handle

function Handle:_finish(wasCancelled)
	if self.Done then
		return
	end
	self.Done = true
	self.Cancelled = wasCancelled
	for _, hitbox in ipairs(self._hitboxes) do
		hitbox:Cancel()
	end
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	if wasCancelled and self._track then
		pcall(function()
			self._track:Stop(0.1)
		end)
	end
	self.Finished:Fire(wasCancelled)
end

-- Stops the animation, cancels pending timeline events and any live hitbox.
function Handle:Cancel()
	self:_finish(true)
end

-- ---------------------------------------------------------------- Move builder
-- Called by every exported move module: `return HitboxSystem.BuildMove(Move)`.
function HitboxSystem.BuildMove(Move)
	Move.LastUsed = setmetatable({}, { __mode = "k" })
	local trackCache = {}

	function Move.IsOnCooldown(character)
		local last = Move.LastUsed[character]
		return last ~= nil and os.clock() - last < Move.Cooldown
	end

	-- options (all optional):
	--   OnHit(hit)       called for each victim. hit = { Attacker, Character, Humanoid, RootPart,
	--                    Position, Direction, Damage, Knockback, HitIndex, Move }.
	--                    Edit hit.Damage / hit.Knockback, or return false to skip built-in damage.
	--   CanHit(model)    return false to ignore a target (teams, friendly fire).
	--   CutsceneTarget   Model the cutscene camera orbits (default: the attacker).
	--   IgnoreCooldown   true to bypass Move.Cooldown.
	-- Returns nil if the move could not start, otherwise a handle:
	--   handle:Cancel(), handle.Started / handle.HitConnected / handle.Finished signals,
	--   handle.Cancelled, handle.Done.  (Finished fires with wasCancelled.)
	function Move.Execute(character, options)
		options = options or {}
		if not RunService:IsServer() then
			warn("[MotionForge] " .. Move.Name .. ".Execute must be called from a server Script")
			return nil
		end
		if typeof(character) ~= "Instance" then
			return nil
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		if not humanoid or not root or humanoid.Health <= 0 then
			return nil
		end

		local now = os.clock()
		if not options.IgnoreCooldown and Move.IsOnCooldown(character) then
			return nil
		end
		Move.LastUsed[character] = now

		local handle = setmetatable({
			Move = Move,
			Character = character,
			Cancelled = false,
			Done = false,
			Started = Signal.new(),
			HitConnected = Signal.new(),
			Finished = Signal.new(),
			_hitboxes = {},
			_connections = {},
		}, Handle)

		table.insert(handle._connections, humanoid.Died:Connect(function()
			handle:Cancel()
		end))

		-- Animation (only plays if the animation is owned by the experience owner/group, or by Roblox)
		local animationLength = 0
		if Move.AnimationId ~= "" then
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if not animator then
				animator = Instance.new("Animator")
				animator.Parent = humanoid
			end
			local track = trackCache[animator]
			if not track then
				local animation = Instance.new("Animation")
				animation.AnimationId = Move.AnimationId
				local ok, result = pcall(function()
					return animator:LoadAnimation(animation)
				end)
				if ok then
					track = result
					trackCache[animator] = track
					animator.Destroying:Connect(function()
						trackCache[animator] = nil
					end)
				else
					warn("[MotionForge] Could not load animation for " .. Move.Name .. ": " .. tostring(result))
				end
			end
			if track then
				track:Play()
				handle._track = track
				animationLength = track.Length
			end
		end

		local function sendCutscene()
			local cutscene = Move.Cutscene
			if not cutscene or not cutscene.Enabled then
				return
			end
			-- Slow motion: slows the animation track only. Hit timing stays in real time.
			if cutscene.SlowMotion and handle._track then
				local track = handle._track
				track:AdjustSpeed(cutscene.SlowMotionFactor or 0.3)
				task.delay(cutscene.Duration or 0.5, function()
					pcall(function()
						track:AdjustSpeed(1)
					end)
				end)
			end
			local player = Players:GetPlayerFromCharacter(character)
			local remote = ReplicatedStorage:FindFirstChild("MotionForge_CutsceneRemote")
			if player and remote then
				remote:FireClient(player, cutscene, options.CutsceneTarget or character)
			end
		end

		local cutsceneSent = false
		for _, event in ipairs(Move.Timeline) do
			task.delay(math.max(event.time, 0), function()
				if handle.Done then
					return
				end
				local data = event.data
				if event.type == "Hitbox" then
					if not cutsceneSent then
						cutsceneSent = true
						sendCutscene()
					end
					local hitbox = HitboxSystem.new(character, {
						Damage = data.damage,
						Knockback = data.knockback,
						Size = data.size,
						Offset = data.offset,
						Duration = data.active,
						CanHit = options.CanHit,
						OnHit = function(hit)
							hit.Move = Move
							handle.HitConnected:Fire(hit)
							if options.OnHit then
								return options.OnHit(hit)
							end
							return true
						end,
					})
					table.insert(handle._hitboxes, hitbox)
					hitbox:Fire()
				elseif event.type == "Sound" then
					HitboxSystem.PlaySound(character, data.soundId)
				elseif event.type == "Effect" then
					HitboxSystem.PlayEffect(character, data.effectType)
				end
			end)
		end

		if (Move.Data.Hits or 0) == 0 then
			task.delay(0, function()
				if not cutsceneSent and not handle.Done then
					cutsceneSent = true
					sendCutscene()
				end
			end)
		end

		task.defer(function()
			handle.Started:Fire()
		end)
		task.delay(math.max(Move.Data.Duration or 0, animationLength), function()
			handle:_finish(false)
		end)

		return handle
	end

	return Move
end

return HitboxSystem
]===]

local CUTSCENE_SOURCE = [===[
-- Client-side cutscene camera effects. Required by the MotionForge_Client LocalScript.
-- Usage from your own client code: require(ReplicatedStorage.MotionForge_Cutscene).Play(cutsceneTable, focusModel)

local RunService = game:GetService("RunService")

local Cutscene = {}
local STEP_NAME = "MotionForgeCutscene"
local current = nil

local function num(value, default, low, high)
	value = tonumber(value)
	if value == nil or value ~= value then
		value = default
	end
	return math.clamp(value, low, high)
end

function Cutscene.Stop()
	if current then
		local active = current
		current = nil
		active.cleanup()
	end
end

function Cutscene.Play(cutscene, focus)
	if typeof(cutscene) ~= "table" or not cutscene.Enabled then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	Cutscene.Stop()

	local duration = num(cutscene.Duration, 0.5, 0.05, 10)
	local shakeOn = cutscene.CameraShake == true
	local shakeAmount = num(cutscene.ShakeIntensity, 2, 0, 20)
	local zoomOn = cutscene.Zoom == true
	local zoomAmount = num(cutscene.ZoomAmount, 0.4, 0, 0.8)
	local rotateOn = cutscene.CameraRotate == true
	local angle = num(cutscene.RotationAngle, 180, 0, 720)
	local speed = num(cutscene.RotationSpeed, 180, 10, 1440)
	local direction = cutscene.RotationDirection == "counter" and -1 or 1

	-- The camera swings out to `angle` degrees and back, so it never snaps at the end.
	local rotateTime = rotateOn and (angle * 2 / speed) or 0
	local total = math.max(duration, rotateTime)

	local focusRoot = nil
	if typeof(focus) == "Instance" then
		focusRoot = focus:FindFirstChild("HumanoidRootPart")
		if not focusRoot and focus:IsA("Model") then
			focusRoot = focus.PrimaryPart
		end
	end

	local baseFov = camera.FieldOfView
	local startTime = os.clock()

	current = {
		cleanup = function()
			pcall(function()
				RunService:UnbindFromRenderStep(STEP_NAME)
			end)
			camera.FieldOfView = baseFov
		end,
	}

	-- Runs right after the default camera update, so it never fights the camera script.
	RunService:BindToRenderStep(STEP_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		local elapsed = os.clock() - startTime
		if elapsed >= total then
			Cutscene.Stop()
			return
		end

		local cframe = camera.CFrame

		if rotateOn and focusRoot and focusRoot.Parent and elapsed < rotateTime then
			local swing = math.rad(angle * direction * math.sin(math.pi * elapsed / rotateTime))
			local pivot = focusRoot.Position
			local offset = cframe.Position - pivot
			local rotated = CFrame.Angles(0, swing, 0):VectorToWorldSpace(offset)
			cframe = CFrame.lookAt(pivot + rotated, pivot)
		end

		if shakeOn and elapsed < duration then
			local amplitude = shakeAmount * 0.1 * (1 - elapsed / duration)
			cframe = cframe * CFrame.new((math.random() * 2 - 1) * amplitude, (math.random() * 2 - 1) * amplitude, 0)
		end
		camera.CFrame = cframe

		if zoomOn and elapsed < duration then
			camera.FieldOfView = baseFov * (1 - zoomAmount * math.sin(math.pi * elapsed / duration))
		else
			camera.FieldOfView = baseFov
		end
	end)
end

return Cutscene
]===]

local CLIENT_SOURCE = [===[
-- Listens for cutscene events from the server and plays them on this player's camera.
-- Safe to leave in StarterPlayerScripts. Re-exporting from MotionForge overwrites this file.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Cutscene = require(ReplicatedStorage:WaitForChild("MotionForge_Cutscene"))
local remote = ReplicatedStorage:WaitForChild("MotionForge_CutsceneRemote")

remote.OnClientEvent:Connect(function(cutscene, focus)
	Cutscene.Play(cutscene, focus)
end)
]===]

-- Marker lines let re-export recognise (and safely overwrite) its own files, but never yours.
local MARK_HITBOX = "-- MotionForge Hitbox System"
local MARK_CUTSCENE = "-- MotionForge Cutscene Module"
local MARK_CLIENT = "-- MotionForge Client"
local MARK_MOVE = "-- MotionForge Exported Move"

local function hitboxSourceFull()
	return MARK_HITBOX .. " v" .. VERSION .. "\n" .. HITBOX_SOURCE
end
local function cutsceneSourceFull()
	return MARK_CUTSCENE .. " v" .. VERSION .. "\n" .. CUTSCENE_SOURCE
end
local function clientSourceFull()
	return MARK_CLIENT .. " v" .. VERSION .. "\n" .. CLIENT_SOURCE
end

