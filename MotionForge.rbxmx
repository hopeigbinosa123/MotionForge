-- ========== MOVE CODE GENERATOR ==========
local MOVE_TEMPLATE = [===[
-- MotionForge Exported Move: {{TITLE}}
-- Generated by MotionForge v{{VERSION}}. Re-exporting overwrites this module, so edit the move in MotionForge.
--
-- Use it from a SERVER script:
--   local move = require(ReplicatedStorage.MotionForge_Moves.{{FILE}})
--   local handle = move.Execute(character, {
--       OnHit = function(hit) hit.Damage = hit.Damage * 2 end,  -- return false to apply damage yourself
--   })
--   if handle then handle:Cancel() end -- e.g. when the fighter gets stunned
--   handle.HitConnected:Connect(function(hit) end)
--   handle.Finished:Connect(function(wasCancelled) end)
-- move.Data has the real numbers (Startup, Active, Damage, Knockback, HitboxSize, ...) for your own combat code.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HitboxSystem = require(ReplicatedStorage:WaitForChild("HitboxSystem"))

local Move = {}
Move.Name = {{NAME}}
Move.Cooldown = {{COOLDOWN}}
Move.AnimationId = {{ANIM}}
Move.Damage = {{DAMAGE}}
Move.Knockback = {{KNOCKBACK}}

-- time = seconds after Execute. Hitbox: size in studs, offset = studs in front of the root part.
Move.Timeline = {
{{TIMELINE}}
}

Move.Cutscene = {
{{CUTSCENE}}
}

Move.Data = {
{{DATA}}
}

return HitboxSystem.BuildMove(Move)
]===]

local CUTSCENE_KEYS = {
	{ "Enabled", "bool" }, { "SlowMotion", "bool" }, { "SlowMotionFactor", "num" },
	{ "CameraShake", "bool" }, { "ShakeIntensity", "num" }, { "Zoom", "bool" }, { "ZoomAmount", "num" },
	{ "Duration", "num" }, { "CameraRotate", "bool" }, { "RotationAngle", "num" },
	{ "RotationSpeed", "num" }, { "RotationDirection", "str" },
}

-- Returns (code, warnings)
local function generateMoveCode()
	local m = currentMove
	sortTimeline()
	local warnings = {}
	local timelineLines = {}
	local firstHit = nil
	local hitCount = 0
	local duration = 0
	local firstTime = nil
	local placeholderSounds = 0
	local defaultDamage = clamp(toNum(m.Damage, 15), 0, 10000)
	local defaultKnockback = clamp(toNum(m.Knockback, 50), 0, 300)

	for _, event in ipairs(m.Timeline) do
		local t = clamp(toNum(event.time, 0), 0, 30)
		local d = event.data or {}
		firstTime = firstTime or t
		if event.type == "Hitbox" then
			local size = parseSize(d.hitboxSize)
			if not size then
				size = Vector3.new(4, 4, 4)
				table.insert(warnings, "a hitbox at " .. fmt(t) .. "s had an invalid size, used 4,4,4")
			end
			local damage = clamp(toNum(d.damage, defaultDamage), 0, 10000)
			local knockback = clamp(toNum(d.knockback, defaultKnockback), 0, 300)
			local offset = clamp(toNum(d.hitboxOffset, 3), -10, 30)
			local active = clamp(toNum(d.active, 0.12), 0.03, 2)
			hitCount = hitCount + 1
			if not firstHit then
				firstHit = { time = t, damage = damage, knockback = knockback, size = size, offset = offset, active = active }
			end
			duration = math.max(duration, t + active)
			table.insert(timelineLines, "    { time = " .. fmt(t) .. ', type = "Hitbox", data = { damage = ' .. fmt(damage)
				.. ", knockback = " .. fmt(knockback) .. ", size = Vector3.new(" .. fmt(size.X) .. ", " .. fmt(size.Y)
				.. ", " .. fmt(size.Z) .. "), offset = " .. fmt(offset) .. ", active = " .. fmt(active) .. " } },")
		elseif event.type == "Sound" then
			local soundId = tostring(d.soundId or "")
			if isPlaceholderSound(soundId) then
				placeholderSounds = placeholderSounds + 1
			end
			duration = math.max(duration, t + 0.1)
			table.insert(timelineLines, "    { time = " .. fmt(t) .. ', type = "Sound", data = { soundId = ' .. luaStr(soundId) .. " } },")
		elseif event.type == "Effect" then
			duration = math.max(duration, t + 0.5)
			table.insert(timelineLines, "    { time = " .. fmt(t) .. ', type = "Effect", data = { effectType = '
				.. luaStr(d.effectType or "Basic Explosion") .. " } },")
		end
	end

	if hitCount == 0 then
		table.insert(warnings, "no Hitbox event, so this move deals no damage")
	end
	if placeholderSounds > 0 then
		table.insert(warnings, placeholderSounds .. " sound(s) still use the placeholder ID (they will stay silent)")
	end

	-- Cutscene as a real Lua table (no JSON, nothing to decode)
	local cs = m.Cutscene
	local csLines = {}
	for _, entry in ipairs(CUTSCENE_KEYS) do
		local key, kind = entry[1], entry[2]
		local value = cs[key]
		local text
		if kind == "bool" then
			text = (value == true) and "true" or "false"
		elseif kind == "num" then
			text = fmt(toNum(value, 0))
		else
			text = luaStr(value or "clockwise")
		end
		table.insert(csLines, "    " .. key .. " = " .. text .. ",")
	end

	-- Real Move.Data from the first hitbox event
	local dataLines = {}
	local function addData(line)
		table.insert(dataLines, "    " .. line .. ",")
	end
	local animId = normalizeAnimId(m.AnimId)
	if firstHit then
		addData("Startup = " .. fmt(firstHit.time))
		addData("Active = " .. fmt(firstHit.active))
		addData("Damage = " .. fmt(firstHit.damage))
		addData("Knockback = " .. fmt(firstHit.knockback))
		addData("HitboxSize = Vector3.new(" .. fmt(firstHit.size.X) .. ", " .. fmt(firstHit.size.Y) .. ", " .. fmt(firstHit.size.Z) .. ")")
		addData("HitboxOffset = " .. fmt(firstHit.offset))
	else
		addData("Startup = " .. fmt(firstTime or 0))
		addData("Active = 0")
		addData("Damage = 0")
		addData("Knockback = 0")
		addData("HitboxSize = Vector3.new(4, 4, 4)")
		addData("HitboxOffset = 3")
	end
	addData("Hits = " .. hitCount)
	addData("Duration = " .. fmt(duration))
	addData("Cooldown = " .. fmt(clamp(toNum(m.Cooldown, 2), 0, 3600)))
	addData("AnimationId = " .. luaStr(animId))

	local values = {
		TITLE = (tostring(m.Name):gsub("[\r\n]", " ")),
		VERSION = VERSION,
		FILE = cleanFileName(m.Name),
		NAME = luaStr(m.Name),
		COOLDOWN = fmt(clamp(toNum(m.Cooldown, 2), 0, 3600)),
		ANIM = luaStr(animId),
		DAMAGE = fmt(defaultDamage),
		KNOCKBACK = fmt(defaultKnockback),
		TIMELINE = table.concat(timelineLines, "\n"),
		CUTSCENE = table.concat(csLines, "\n"),
		DATA = table.concat(dataLines, "\n"),
	}
	local code = MOVE_TEMPLATE:gsub("{{(%w+)}}", function(key)
		return values[key]
	end)
	return code, warnings
end

-- ========== EXPORT: COPY TO CLIPBOARD ==========
local function exportToClipboard()
	if #currentMove.Timeline == 0 then
		flashStatus("Add at least one event before exporting!", true)
		return
	end
	local moveCode = generateMoveCode()
	local sources = {
		{ "Move", moveCode },
		{ "HitboxSystem", hitboxSourceFull() },
		{ "Cutscene", cutsceneSourceFull() },
		{ "Client", clientSourceFull() },
	}

	local panel, close = openDialog("Select all, then Ctrl+C", 440)
	addNote(panel, "Move goes in ReplicatedStorage.MotionForge_Moves. The other three are shared runtime scripts (HitboxSystem and MotionForge_Cutscene in ReplicatedStorage, MotionForge_Client as a LocalScript in StarterPlayerScripts). Easier: use Export to ReplicatedStorage.")

	local textBox = Instance.new("TextBox")
	textBox.Text = moveCode
	textBox.TextColor3 = Color3.fromRGB(200, 200, 200)
	textBox.TextSize = 11
	textBox.Font = Enum.Font.Code
	textBox.TextXAlignment = Enum.TextXAlignment.Left
	textBox.TextYAlignment = Enum.TextYAlignment.Top
	textBox.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
	textBox.BorderSizePixel = 0
	textBox.Size = UDim2.new(1, 0, 0, 280)
	textBox.ClearTextOnFocus = false
	textBox.MultiLine = true
	textBox.TextWrapped = false
	textBox.LayoutOrder = 5
	textBox.Parent = panel
	addCorner(textBox, 8)

	local tabSpecs = {}
	for _, entry in ipairs(sources) do
		table.insert(tabSpecs, { entry[1], C.dark, function()
			textBox.Text = entry[2]
		end })
	end
	addButtonRow(panel, tabSpecs, 30)
	addButton(panel, "Close", C.blue, 34, close)
end

-- ========== EXPORT: WRITE INTO THE GAME ==========
-- Create or update a script by name. Never touches a same-named script that isn't MotionForge's.
-- Returns (instance or nil, "created" | "updated" | "blocked", duplicatesRemoved)
local function upsertScript(parent, name, className, source, marker)
	local sameClass = {}
	local blocked = false
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name == name then
			if child.ClassName == className then
				table.insert(sameClass, child)
			else
				blocked = true
			end
		end
	end

	local ours = {}
	for _, child in ipairs(sameClass) do
		local ok, src = pcall(function()
			return child.Source
		end)
		if ok and (src == "" or string.sub(src, 1, #marker) == marker) then
			table.insert(ours, child)
		end
	end

	if #ours == 0 and (#sameClass > 0 or blocked) then
		return nil, "blocked", 0
	end

	local target = ours[1]
	local action = "updated"
	if not target then
		target = Instance.new(className)
		target.Name = name
		target.Parent = parent
		action = "created"
	end
	target.Source = source

	local removed = 0
	for i = 2, #ours do
		ours[i]:Destroy()
		removed = removed + 1
	end
	return target, action, removed
end

local function exportToGame()
	if #currentMove.Timeline == 0 then
		flashStatus("Add at least one event before exporting!", true)
		return
	end

	local moveCode, warnings = generateMoveCode()
	local problems = {}
	local notes = {}

	local folder = ReplicatedStorage:FindFirstChild("MotionForge_Moves")
	if folder and not folder:IsA("Folder") then
		flashStatus("ReplicatedStorage.MotionForge_Moves exists but isn't a Folder", true)
		return
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "MotionForge_Moves"
		folder.Parent = ReplicatedStorage
	end

	local function put(parent, name, className, source, marker)
		local instance, action, removed = upsertScript(parent, name, className, source, marker)
		if action == "blocked" then
			table.insert(problems, parent.Name .. "." .. name .. " already exists and isn't a MotionForge script")
		elseif removed > 0 then
			table.insert(notes, "removed " .. removed .. " duplicate " .. name)
		end
		return instance, action
	end

	-- Shared runtime (always refreshed so fixes reach every move)
	put(ReplicatedStorage, "HitboxSystem", "ModuleScript", hitboxSourceFull(), MARK_HITBOX)
	put(ReplicatedStorage, "MotionForge_Cutscene", "ModuleScript", cutsceneSourceFull(), MARK_CUTSCENE)

	local remote = ReplicatedStorage:FindFirstChild("MotionForge_CutsceneRemote")
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = "MotionForge_CutsceneRemote"
		remote.Parent = ReplicatedStorage
	end

	local playerScripts = StarterPlayer:FindFirstChild("StarterPlayerScripts")
	if playerScripts then
		put(playerScripts, "MotionForge_Client", "LocalScript", clientSourceFull(), MARK_CLIENT)
	else
		table.insert(problems, "StarterPlayerScripts not found, so cutscenes need MotionForge_Client added by hand")
	end

	-- The move itself: overwrite in place, never duplicate
	local moveModule, moveAction = put(folder, cleanFileName(currentMove.Name), "ModuleScript", moveCode, MARK_MOVE)

	pcall(function()
		ChangeHistoryService:SetWaypoint("MotionForge export: " .. currentMove.Name)
	end)
	if moveModule then
		pcall(function()
			Selection:Set({ moveModule })
		end)
	end

	for _, w in ipairs(warnings) do
		print("[MotionForge] " .. currentMove.Name .. ": " .. w)
	end
	for _, p in ipairs(problems) do
		warn("[MotionForge] " .. p)
	end

	if #problems > 0 then
		flashStatus("Export problem: " .. problems[1], true)
	else
		local text = "Move " .. (moveAction or "exported") .. ": MotionForge_Moves." .. cleanFileName(currentMove.Name)
		if #notes > 0 then
			text = text .. " (" .. table.concat(notes, ", ") .. ")"
		end
		if #warnings > 0 then
			text = text .. " | " .. #warnings .. " warning(s), see Output"
		end
		flashStatus(text, #warnings > 0)
	end
end

-- ========== SAVE / LOAD ==========
local SAVE_PREFIX = "MotionForge_Move_"

local function saveKey(moveName)
	return SAVE_PREFIX .. string.gsub(moveName, "[^%w%-_]", "_")
end

local function getSavedMoveNames()
	local raw = plugin:GetSetting("MotionForge_SavedMoves")
	if raw and raw ~= "" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if ok and type(decoded) == "table" then
			return decoded
		end
	end
	return {}
end

local function saveMoveNameList(names)
	pcall(function()
		plugin:SetSetting("MotionForge_SavedMoves", HttpService:JSONEncode(names))
	end)
end

-- Pushes currentMove into every control (text boxes, toggles, lists, previews)
local function syncAll()
	if UI.syncAll then
		UI.syncAll()
	end
	mainGui.Title = "MotionForge - " .. currentMove.Name
	updateStatus()
	refreshVisualizer()
end

local function applyMove(moveData)
	stopAllPreviews()
	currentMove = moveData
	selectedEvent = nil
	syncAll()
end

local function saveCurrentMove()
	local moveName = currentMove.Name
	if not moveName or moveName == "" then
		moveName = "Unnamed Move"
		currentMove.Name = moveName
	end
	local data = deepCopy(currentMove)
	data.Version = VERSION

	local ok = pcall(function()
		plugin:SetSetting(saveKey(moveName), HttpService:JSONEncode(data))
	end)
	if not ok then
		flashStatus("Couldn't save (settings write failed)", true)
		return
	end

	local names = getSavedMoveNames()
	if not table.find(names, moveName) then
		table.insert(names, moveName)
		saveMoveNameList(names)
	end
	flashStatus("Saved: " .. moveName, false)
	if UI.refreshMoves then
		UI.refreshMoves()
	end
end

local function loadMoveByName(moveName)
	local raw = plugin:GetSetting(saveKey(moveName))
	if not raw or raw == "" then
		flashStatus("Nothing saved under " .. moveName, true)
		return
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(data) == "table" then
		applyMove(sanitizeMove(data))
		flashStatus("Loaded: " .. moveName, false)
	else
		flashStatus("Saved data for " .. moveName .. " is corrupt", true)
	end
end

local function deleteMoveByName(moveName)
	plugin:SetSetting(saveKey(moveName), nil)
	local kept = {}
	for _, name in ipairs(getSavedMoveNames()) do
		if name ~= moveName then
			table.insert(kept, name)
		end
	end
	saveMoveNameList(kept)
	if UI.refreshMoves then
		UI.refreshMoves()
	end
end

local function loadTemplate(template)
	applyMove(sanitizeMove(template.Data))
	flashStatus("Loaded template: " .. template.Name, false)
end

