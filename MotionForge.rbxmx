-- ========== COLORS ==========
local C = {
	bg = Color3.fromRGB(20, 20, 24),
	bar = Color3.fromRGB(30, 30, 35),
	card = Color3.fromRGB(28, 28, 32),
	field = Color3.fromRGB(45, 45, 50),
	list = Color3.fromRGB(40, 40, 45),
	row = Color3.fromRGB(50, 50, 55),
	text = Color3.fromRGB(235, 235, 240),
	sub = Color3.fromRGB(160, 160, 170),
	dim = Color3.fromRGB(110, 110, 120),
	blue = Color3.fromRGB(0, 120, 215),
	grey = Color3.fromRGB(70, 70, 82),
	dark = Color3.fromRGB(60, 60, 70),
	green = Color3.fromRGB(50, 160, 70),
	red = Color3.fromRGB(180, 50, 50),
	purple = Color3.fromRGB(100, 100, 125),
